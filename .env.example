# Copy to .env. Only ADMIN_PASSWORD is required.
ADMIN_PASSWORD=change-me-to-something-long

# First-run defaults; once saved in the editor, the editor's values win.
UPSTREAM_URL=
# Hours between syncs (6) or a cron expression (0 */6 * * *), evaluated in TZ.
SYNC_SCHEDULE=6
# The hostname players reach you on, e.g. https://epg.example.com
PUBLIC_URL=
TZ=UTC

# Optional Cloudflare Tunnel (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# Optional Cloudflare R2 mirror, uploaded after every build. Public bucket URL: access keys do not apply to it.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
