# Copy to .env. Only ADMIN_PASSWORD is required.
ADMIN_PASSWORD=change-me-to-something-long

# First-run defaults; once saved in the editor, the editor's values win.
# Your provider's Xtream Codes login.
XTREAM_URL=
XTREAM_USER=
XTREAM_PASS=
# Only for a provider that gives an M3U link instead of a login.
PLAYLIST_URL=
# The XMLTV guide from your EPG supplier.
UPSTREAM_URL=
# A cron expression evaluated in TZ (default: every day at 04:00), or hours between syncs (24).
SYNC_SCHEDULE="0 4 * * *"
# The hostname players reach you on, e.g. https://tv.example.com
PUBLIC_URL=
TZ=UTC

# Optional Cloudflare Tunnel (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# Optional Cloudflare R2 mirror, uploaded after every build. Public bucket URL: access keys do not apply to it.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
